# ─────────────────────────────────────────────────────────────
#  Variables de entorno — Pomodoro Forest
#  Local:   copia este archivo a .env y rellena los valores.
#  Railway: añádelas en el servicio → pestaña "Variables".
# ─────────────────────────────────────────────────────────────

# ── OBLIGATORIAS ─────────────────────────────────────────────

# Connection string de PostgreSQL.
# Railway: crea un servicio PostgreSQL y referencia su variable:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@localhost:5432/pomodoro_forest

# Clave para firmar los JWT (mínimo 32 caracteres).
# Genérala con:  openssl rand -base64 32
SECRET_KEY=your-secret-key-at-least-32-characters

# ── EMAIL — Resend (necesario en producción) ─────────────────
# Verificación de cuenta y recuperación de contraseña. Sin RESEND_API_KEY los
# códigos se imprimen en los logs (solo dev), por lo que en producción real
# los usuarios no podrían verificarse sin estas dos variables.
# Obtén la API key en https://resend.com → API Keys.
RESEND_API_KEY=re_xxxxxxxxxxxxx
# Remitente verificado en Resend (tu dominio, o onboarding@resend.dev para pruebas).
EMAIL_FROM=noreply@yourdomain.com

# ── OPCIONALES ───────────────────────────────────────────────

# Cloudinary — subida de imágenes de plantillas en el panel admin.
# Sin estas claves la app funciona, pero /api/upload responde 503
# (puedes pegar URLs de imagen manualmente).
# Obtén las credenciales en https://cloudinary.com → Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URL pública de la app. Reservada: el código actual no la usa (los emails
# envían un código, no un enlace). Defínela con el dominio de Railway por si
# se añaden enlaces en el futuro: https://tu-app.up.railway.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
